{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/fact.json",
  "title": "Fact",
  "description": "A typed assertion with provenance and status (Part 3 \u00a73.3).",
  "type": "object",
  "properties": {
    "tenant_id": {
      "$ref": "common.json#/definitions/tenant_id"
    },
    "schema_version": {
      "$ref": "common.json#/definitions/schema_version"
    },
    "fact_id": {
      "$ref": "common.json#/definitions/id_field"
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "VERIFIED",
        "CONFLICTED",
        "SUPERSEDED",
        "REJECTED"
      ]
    },
    "label": {
      "type": "string",
      "enum": [
        "OFFICIAL",
        "DERIVED",
        "SECONDARY",
        "SIMULATED_RULE",
        "SYNTHETIC",
        "ASSUMPTION",
        "UNVERIFIED"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "$ref": "common.json#/definitions/id_field"
    },
    "locator": {
      "type": "string"
    },
    "extraction_method": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": [
    "tenant_id",
    "schema_version",
    "fact_id",
    "key",
    "value",
    "status",
    "label",
    "source_id"
  ],
  "additionalProperties": false
}
