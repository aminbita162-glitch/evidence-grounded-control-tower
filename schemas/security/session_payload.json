{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/security/session_payload.json",
  "title": "Signed session payload",
  "type": "object",
  "properties": {
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "viewer",
        "operator",
        "reviewer",
        "administrator",
        "platform"
      ]
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "principal_id",
    "role",
    "tenant_id",
    "issued_at",
    "expires_at"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "role": {
        "const": "platform"
      }
    }
  },
  "then": {
    "properties": {
      "tenant_id": {
        "type": "null"
      }
    }
  },
  "else": {
    "properties": {
      "tenant_id": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
