{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/common.json",
  "title": "Common Types",
  "description": "Shared type definitions for kernel entity schemas (Part 3 \u00a73.3).",
  "definitions": {
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque tenant identifier."
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for migration tracking."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp."
    },
    "hash_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hash as 64 lowercase hex chars."
    },
    "id_field": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque unique identifier."
    }
  }
}
